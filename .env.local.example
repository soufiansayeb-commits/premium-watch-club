# Server-side only — never prefix these with NEXT_PUBLIC_.
WOOCOMMERCE_STORE_URL=https://checkout.premiumwatchclub.com
# REST API key with READ access, owned by a user who can edit products
# (needed to read the skill-question correct answer, which is hidden from the public API).
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must match define('PWC_CART_HANDOFF_SECRET', ...) in WordPress wp-config.php
PWC_CART_HANDOFF_SECRET=replace-with-openssl-rand-hex-32

# Public — only the checkout origin, used by the browser to read the Woo cart.
NEXT_PUBLIC_WOOCOMMERCE_CHECKOUT_URL=https://checkout.premiumwatchclub.com/checkout/

# Not used: pages refresh WooCommerce data every 60 s (ISR), so there is no
# /api/revalidate webhook. Safe to remove from Vercel.
# REVALIDATION_SECRET=
